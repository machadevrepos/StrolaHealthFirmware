#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <100000>;

    pinctrl-0 = <&i2c0_bmi270_default>;
    pinctrl-1 = <&i2c0_bmi270_sleep>;
    pinctrl-names = "default", "sleep";

    bmi270: bmi270@69 {
        compatible = "i2c-device";
        reg = <0x69>;
        status = "okay";
    };
};

&pinctrl {
    i2c0_bmi270_default: i2c0_bmi270_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 27)>,
                    <NRF_PSEL(TWIM_SCL, 0, 26)>;
            bias-pull-up;
        };
    };

    i2c0_bmi270_sleep: i2c0_bmi270_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 27)>,
                    <NRF_PSEL(TWIM_SCL, 0, 26)>;
            low-power-enable;
        };
    };
};
